# Bind the API to loopback by default. Add a LAN address only when required.
LOCAL_SEARCH_HOST=127.0.0.1
LOCAL_SEARCH_PORT=17890

# Exact browser origins and HTTP Host values allowed to call the service.
LOCAL_SEARCH_ALLOWED_ORIGINS=http://127.0.0.1:5273,http://localhost:5273
LOCAL_SEARCH_ADDITIONAL_ORIGINS=
LOCAL_SEARCH_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# SearXNG is published only on loopback by default.
SEARXNG_BIND_ADDRESS=127.0.0.1
SEARXNG_PORT=17891
SEARXNG_SECRET=replace-with-a-random-local-secret

# Optional tuning.
LOCAL_SEARCH_CACHE_TTL=300
LOCAL_EXTRACT_CACHE_TTL=86400
LOCAL_SEARCH_REQUEST_TIMEOUT=20
LOCAL_SEARCH_BROWSER_TIMEOUT=30
LOCAL_SEARCH_MAX_DOWNLOAD_BYTES=5242880
LOCAL_SEARCH_BROWSER_FALLBACK=true
LOCAL_SEARCH_TRUST_ENV_PROXY=false
